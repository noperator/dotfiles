#!/bin/sh

# Allow bypass
[ -f "$(git rev-parse --git-dir)/NO_COMMITLINT" ] && exit 0

COMMITLINT=$(command -v commitlint 2>/dev/null)

if [ -z "$COMMITLINT" ]; then
    echo "commitlint not installed"
    exit 1
fi

# Resolve the executable to its installed package, then expose that
# installation's node_modules so commitlint can resolve shared configs.
COMMITLINT=$(realpath "$COMMITLINT")
NODE_MODULES=$(dirname "$(dirname "$(dirname "$COMMITLINT")")")
export NODE_PATH="$NODE_MODULES${NODE_PATH:+:$NODE_PATH}"

exec "$COMMITLINT" \
    --config "$HOME/.commitlintrc.js" \
    --edit "$1"
